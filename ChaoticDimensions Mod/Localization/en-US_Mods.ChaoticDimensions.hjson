MoonTalk: {
	Dialogue: {
		Line01: Hello... player.
		Line02: Welcome to your new world.
		Line03: You will face things never seen before.
		Line04: All your knowledge and everything you know will be destroyed before you.
		Line05: I am everything you will need here.
		Line06: Your only ally.
		Line07: I will do everything I can to help you.
		Line08: But it will cost you dearly.
		Line09: Good luck, player.
		Line10: You will need it.
	}
}
